# ─────────────────────────────────────────────
#  Code-To-Carrer — .gitignore
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js ───────────────────────────────────
/.next/
/out/
/build
next-env.d.ts

# ── Environment & Secrets ─────────────────────
.env
.env.*
.env.local
.env.local.*
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem
secrets/
*.key
*.cert

# ── Vercel ────────────────────────────────────
.vercel

# ── TypeScript ────────────────────────────────
*.tsbuildinfo

# ── Testing & Coverage ────────────────────────
/coverage
/.nyc_output
/test-results
/playwright-report
/cypress/videos
/cypress/screenshots

# ── Logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# ── OS Generated Files ────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE & Editor Files ────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace

# ── Debug & Temp Files ────────────────────────
*.tmp
*.temp
*.cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ── Build Artifacts ───────────────────────────
/dist
/storybook-static

# ── Prisma (if used in future) ────────────────
prisma/*.db
prisma/*.db-journal

# ── Docker ────────────────────────────────────
docker-compose.override.yml

# ── Package Manager Locks (keep only one) ─────
# Uncomment if you only use npm:
# yarn.lock
# pnpm-lock.yaml
